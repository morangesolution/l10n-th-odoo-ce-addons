<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form_ocr" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.l10n_th_ocr</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='account_digitalization']" position="after">
                <block title="Thai OCR Document Parser" id="l10n_th_ocr_block">
                    <setting string="OCR Service URL"
                             help="URL of the OCR microservice that reads PDF/image bills (e.g. http://localhost:8001)">
                        <field name="ocr_service_url" placeholder="http://localhost:8001"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
