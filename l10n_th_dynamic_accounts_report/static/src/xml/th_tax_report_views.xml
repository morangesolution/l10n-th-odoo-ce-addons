<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-name="th_tax_r_template" owl="1">
        <div class="container">
            <div class="fin_report">
                <div class="filter_view_gl pt-3 pb-5">
                    <div>
                        <h2 class="text-uppercase" style="padding:10px">
                            <t t-esc="props.action.name"/>
                        </h2>
                    </div>
                    <div style="margin-right:10px;margin-left:10px;margin-bottom:15px;display:flex;">
                        <div class="sub_container_left" style="width:70%;">
                            <div class="report_print">
                                <button type="button" class="btn btn-primary btn-report-print"
                                        t-on-click="printPdf" style="margin-right:8px;">
                                    Print (PDF)
                                </button>
                                <button type="button" class="btn btn-primary btn-report-print"
                                        t-on-click="print_xlsx">
                                    Export (XLSX)
                                </button>
                            </div>
                        </div>
                        <div class="d-flex justify-content-end">
                            <!-- Date Range -->
                            <div class="time_range">
                                <a type="button" class="dropdown-toggle" data-bs-toggle="dropdown">
                                    <span class="fa fa-calendar" role="img"/>
                                    Date Range
                                </a>
                                <div class="dropdown-menu" role="menu">
                                    <div class="list-group">
                                        <button class="report-filter-button" t-att-data-value="'month'" type="button" t-on-click="applyFilter">This Month</button>
                                        <button class="report-filter-button" t-att-data-value="'quarter'" type="button" t-on-click="applyFilter">This Quarter</button>
                                        <button class="report-filter-button" t-att-data-value="'year'" type="button" t-on-click="applyFilter">This Year</button>
                                        <div role="separator" class="dropdown-divider"/>
                                        <button class="report-filter-button" t-att-data-value="'last-month'" type="button" t-on-click="applyFilter">Last Month</button>
                                        <button class="report-filter-button" t-att-data-value="'last-quarter'" type="button" t-on-click="applyFilter">Last Quarter</button>
                                        <button class="report-filter-button" t-att-data-value="'last-year'" type="button" t-on-click="applyFilter">Last Year</button>
                                        <div role="separator" class="dropdown-divider"/>
                                        <label for="date_from">Start Date:</label>
                                        <input type="date" id="start_date" t-ref="date_from"
                                               t-on-change="applyDateInput"
                                               style="border:none;border-bottom:1px solid #000;padding:5px;outline:none;"
                                               name="start_date"/>
                                        <label for="date_to">End Date:</label>
                                        <input type="date" id="end_date" t-ref="date_to"
                                               t-on-change="applyDateInput"
                                               style="border:none;border-bottom:1px solid #000;padding:5px;outline:none;"
                                               name="end_date"/>
                                    </div>
                                </div>
                            </div>
                            <!-- Tax Type -->
                            <div class="option">
                                <a type="button" class="dropdown-toggle" data-bs-toggle="dropdown">
                                    <span class="fa fa-file-text-o" role="img"/>
                                    Type: <t t-esc="state.tax_type === 'sale' ? 'Sale VAT' : 'Purchase VAT'"/>
                                </a>
                                <div class="dropdown-menu" role="menu">
                                    <div class="list-group">
                                        <button class="report-filter-button" t-att-data-value="'sale'" type="button" t-on-click="applyFilter">Sale VAT</button>
                                        <button class="report-filter-button" t-att-data-value="'purchase'" type="button" t-on-click="applyFilter">Purchase VAT</button>
                                    </div>
                                </div>
                            </div>
                            <!-- Options -->
                            <div class="option">
                                <a type="button" class="dropdown-toggle" data-bs-toggle="dropdown">
                                    <span class="fa fa-cog" role="img"/>
                                    Options
                                </a>
                                <div class="dropdown-menu" role="menu">
                                    <div class="list-group">
                                        <button class="report-filter-button" t-att-data-value="'show_cancel'"
                                                type="button" t-on-click="applyFilter">
                                            <t t-if="state.show_cancel">&#10003; </t>
                                            Show Cancelled
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Table -->
            <div class="table_style" style="height:650px;overflow-y:scroll;">
                <div class="table_view_gl" style="right:20px;width:100%;">
                    <table cellspacing="0" width="100%">
                        <thead>
                            <tr class="o_heading" style="text-align:center;">
                                <th>No.</th>
                                <th>Date</th>
                                <th>Tax Inv. No.</th>
                                <th>Partner</th>
                                <th>Tax ID</th>
                                <th>Branch</th>
                                <th>Base Amount</th>
                                <th>Tax Amount</th>
                                <th>Ref</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-if="state.data and state.data.lines and state.data.lines.length > 0">
                                <t t-foreach="state.data.lines" t-as="line" t-key="line.no">
                                    <tr t-att-class="line.tax_invoice_number.includes('(VOID)') ? 'text-muted' : ''">
                                        <td style="text-align:center;"><t t-esc="line.no"/></td>
                                        <td><t t-esc="line.tax_date"/></td>
                                        <td><t t-esc="line.tax_invoice_number"/></td>
                                        <td><t t-esc="line.partner_name"/></td>
                                        <td><t t-esc="line.partner_vat"/></td>
                                        <td><t t-esc="line.partner_branch"/></td>
                                        <td style="text-align:right;"><t t-esc="formatAmount(line.base_amount)"/></td>
                                        <td style="text-align:right;"><t t-esc="formatAmount(line.tax_amount)"/></td>
                                        <td><t t-esc="line.doc_ref"/></td>
                                    </tr>
                                </t>
                                <!-- Totals row -->
                                <tr style="font-weight:bold;background-color:#f8f9fa;">
                                    <td colspan="6" style="text-align:right;">Total</td>
                                    <td style="text-align:right;"><t t-esc="formatAmount(state.data.total_base)"/></td>
                                    <td style="text-align:right;"><t t-esc="formatAmount(state.data.total_tax)"/></td>
                                    <td/>
                                </tr>
                            </t>
                            <t t-else="">
                                <tr>
                                    <td colspan="9" style="text-align:center;padding:20px;color:#888;">
                                        No data found for the selected period.
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </t>
</templates>
