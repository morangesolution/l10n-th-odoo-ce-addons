# ──────────────────────────────────────────────
# Choose ONE provider block and copy to .env
# ──────────────────────────────────────────────

# --- Option A: OpenAI ---
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o
LLM_VISION_MODEL=gpt-4o

# --- Option B: OpenRouter (openrouter.ai) ---
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-your-key-here
# LLM_MODEL=openai/gpt-4o
# LLM_VISION_MODEL=openai/gpt-4o
# LLM_SITE_URL=https://yourapp.com   # shown in OpenRouter dashboard (optional)
# LLM_SITE_NAME=MyOdooOCR            # shown in OpenRouter dashboard (optional)
# # Other good vision models on OpenRouter:
# # LLM_MODEL=anthropic/claude-3.5-sonnet
# # LLM_MODEL=google/gemini-flash-1.5
# # LLM_MODEL=meta-llama/llama-3.2-11b-vision-instruct

# --- Option C: opencode.ai (check their API docs for base URL) ---
# LLM_BASE_URL=https://api.opencode.ai/v1   # replace with actual endpoint
# LLM_API_KEY=your-opencode-key
# LLM_MODEL=model-name-from-their-docs
# LLM_VISION_MODEL=model-name-from-their-docs

# --- Option D: Google Gemini (direct, via Google AI Studio key) ---
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=AIza-your-google-ai-studio-key
# LLM_MODEL=gemini-2.0-flash
# LLM_VISION_MODEL=gemini-2.0-flash
# # Other Gemini vision models:
# # LLM_MODEL=gemini-1.5-pro
# # LLM_MODEL=gemini-1.5-flash

# --- Option E: Google Gemini via OpenRouter ---
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-your-key-here
# LLM_MODEL=google/gemini-2.0-flash-001
# LLM_VISION_MODEL=google/gemini-2.0-flash-001

# --- Option F: Ollama (local, self-hosted) ---
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=none
# LLM_MODEL=qwen2.5:7b
# LLM_VISION_MODEL=qwen2.5vl:7b
# LLM_JSON_MODE=false   # disable for Ollama models that don't support json_object

# ──────────────────────────────────────────────
OCR_TIMEOUT=30
SCANNED_TEXT_THRESHOLD=50
LLM_JSON_MODE=true   # set to false for providers that don't support json_object response_format
