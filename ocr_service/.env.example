# ──────────────────────────────────────────────
# Choose ONE provider block and copy to .env
# ──────────────────────────────────────────────

# --- Option A: OpenAI ---
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o
LLM_VISION_MODEL=gpt-4o

# --- Option B: OpenRouter (openrouter.ai) ---
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-your-key-here
# LLM_MODEL=openai/gpt-4o
# LLM_VISION_MODEL=openai/gpt-4o
# LLM_SITE_URL=https://yourapp.com   # shown in OpenRouter dashboard (optional)
# LLM_SITE_NAME=MyOdooOCR            # shown in OpenRouter dashboard (optional)
# # Other good vision models on OpenRouter:
# # LLM_MODEL=anthropic/claude-3.5-sonnet
# # LLM_MODEL=google/gemini-flash-1.5
# # LLM_MODEL=meta-llama/llama-3.2-11b-vision-instruct

# --- Option C: opencode.ai (check their API docs for base URL) ---
# LLM_BASE_URL=https://api.opencode.ai/v1   # replace with actual endpoint
# LLM_API_KEY=your-opencode-key
# LLM_MODEL=model-name-from-their-docs
# LLM_VISION_MODEL=model-name-from-their-docs

# --- Option D: Ollama (local, self-hosted) ---
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=none
# LLM_MODEL=qwen2.5:7b
# LLM_VISION_MODEL=qwen2.5vl:7b

# ──────────────────────────────────────────────
OCR_TIMEOUT=30
SCANNED_TEXT_THRESHOLD=50
